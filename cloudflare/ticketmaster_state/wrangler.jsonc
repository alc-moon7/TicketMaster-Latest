{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ticketmaster-user-state",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "ticketmaster-61fd5"
  },
  "d1_databases": [
    {
      "binding": "STATE_DB",
      "database_name": "ticketmaster-user-state",
      "database_id": "dfc81596-63c3-4888-b0f5-e4f6bb3fc5e5",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "ticketmaster-user-images"
    }
  ]
}
